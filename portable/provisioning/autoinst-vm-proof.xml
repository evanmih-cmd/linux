<?xml version='1.0' encoding='UTF-8'?>
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <general>
    <mode>
      <confirm config:type="boolean">false</confirm>
      <second_stage config:type="boolean">false</second_stage>
    </mode>
    <ask-list config:type="list">
      <ask>
        <title>Portable workstation recovery credential</title>
        <question>Enter the strong LUKS recovery passphrase</question>
        <type>string</type>
        <password config:type="boolean">true</password>
        <path>partitioning,0,partitions,1,crypt_key</path>
        <stage>initial</stage>
        </ask>
      <ask>
        <title>Portable workstation TPM credential</title>
        <question>Enter the short TPM2 boot PIN</question>
        <type>string</type>
        <password config:type="boolean">true</password>
        <stage>initial</stage>
        <file>/etc/desktop-linux-tpm2-pin</file>
        </ask>
      <ask>
        <title>Portable workstation administrator</title>
        <question>Enter the root password</question>
        <type>string</type>
        <password config:type="boolean">true</password>
        <path>users,0,user_password</path>
        <stage>initial</stage>
        </ask>
    </ask-list>
  </general>
  <language><language>en_US</language></language>
  <keyboard><keymap>english-us</keymap></keyboard>
  <timezone><hwclock>UTC</hwclock><timezone>Europe/Berlin</timezone></timezone>
  <networking>
    <dns>
      <hostname>portable</hostname>
    </dns>
  </networking>
  <partitioning config:type="list">
    <drive>
      <device>__TARGET_DEVICE__</device>
      <initialize config:type="boolean">true</initialize>
      <disklabel>gpt</disklabel>
      <partitions config:type="list">
        <partition>
          <mount>/boot/efi</mount>
          <filesystem config:type="symbol">vfat</filesystem>
          <format config:type="boolean">true</format>
          <size>1GiB</size>
          <partition_id config:type="integer">259</partition_id>
        </partition>
        <partition>
          <size>max</size>
          <lvm_group>system</lvm_group>
          <crypt_method config:type="symbol">systemd_fde</crypt_method>
          <crypt_key>__ASK__</crypt_key>
          <crypt_pbkdf config:type="symbol">argon2id</crypt_pbkdf>
          <crypt_label>portable-system</crypt_label>
        </partition>
      </partitions>
    </drive>
    <drive>
      <device>/dev/system</device>
      <type config:type="symbol">CT_LVM</type>
      <enable_snapshots config:type="boolean">true</enable_snapshots>
      <partitions config:type="list">
        <partition>
          <lv_name>root</lv_name>
          <mount>/</mount>
          <filesystem config:type="symbol">btrfs</filesystem>
          <format config:type="boolean">true</format>
          <size>24GiB</size>
        </partition>
        <partition>
          <lv_name>home</lv_name>
          <mount>/home</mount>
          <filesystem config:type="symbol">xfs</filesystem>
          <format config:type="boolean">true</format>
          <size>max</size>
        </partition>
        <partition>
          <lv_name>swap</lv_name>
          <mount>swap</mount>
          <filesystem config:type="symbol">swap</filesystem>
          <format config:type="boolean">true</format>
          <size>2GiB</size>
        </partition>
      </partitions>
    </drive>
  </partitioning>
  <bootloader>
    <loader_type>systemd-boot</loader_type>
    <global>
      <secure_boot>true</secure_boot>
      <update_nvram>false</update_nvram>
      <timeout config:type="integer">5</timeout>
    </global>
  </bootloader>
  <add-on>
    <add_on_others config:type="list">
      <listentry>
        <media_url>repo:/</media_url>
        <product_dir>/portable/google</product_dir>
        <alias>portable-google-chrome</alias>
        <name>Portable Google Chrome mirror</name>
        <priority config:type="integer">110</priority>
        <ask_on_error config:type="boolean">false</ask_on_error>
        <confirm_license config:type="boolean">false</confirm_license>
        <signature-handling>
          <accept_unknown_gpg_key>
            <all config:type="boolean">false</all>
            <keys config:type="list">
              <keyid>7721F63BD38B4796</keyid>
            </keys>
          </accept_unknown_gpg_key>
          <import_gpg_key>
            <all config:type="boolean">false</all>
            <keys config:type="list">
              <keyid>7721F63BD38B4796</keyid>
            </keys>
          </import_gpg_key>
        </signature-handling>
      </listentry>
      <listentry>
        <media_url>repo:/</media_url>
        <product_dir>/portable/opensuse</product_dir>
        <alias>portable-opensuse-snapshot</alias>
        <name>Portable openSUSE Snapshot20260930 add-on</name>
        <priority config:type="integer">120</priority>
        <ask_on_error config:type="boolean">false</ask_on_error>
        <confirm_license config:type="boolean">false</confirm_license>
      </listentry>
    </add_on_others>
  </add-on>
  <software>
    <patterns config:type="list">
      <pattern>base</pattern>
      <pattern>hardware</pattern>
      <pattern>kde_plasma</pattern>
    </patterns>
    <packages config:type="list">
      <package>sdbootutil</package>
      <package>sdbootutil-enroll</package>
      <package>sdbootutil-kernel-install</package>
      <package>sdbootutil-snapper</package>
      <package>systemd-boot</package>
      <package>cryptsetup</package>
      <package>lvm2</package>
      <package>btrfsprogs</package>
      <package>xfsprogs</package>
      <package>snapper</package>
      <package>shim</package>
      <package>mokutil</package>
      <package>NetworkManager</package>
      <package>plasma6-nm</package>
      <package>wpa_supplicant</package>
      <package>firewalld</package>
      <package>sudo</package>
      <package>konsole</package>
      <package>sddm-qt6</package>
      <package>MozillaFirefox</package>
      <package>google-chrome-stable</package>
      <package>transactional-update</package>
      <package>zypp-boot-plugin</package>
      <package>sdbootutil-tukit</package>
      <package>util-linux</package>
      <package>coreutils</package>
    </packages>
    <do_online_update config:type="boolean">false</do_online_update>
    <install_recommended config:type="boolean">true</install_recommended>
  </software>
  <files config:type="list">
    <file>
      <file_path>/etc/udev/rules.d/20-hw1.rules</file_path>
      <file_owner>root:root</file_owner>
      <file_permissions>0644</file_permissions>
      <file_contents><![CDATA[# HW.1, Nano
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2581", ATTRS{idProduct}=="1b7c|2b7c|3b7c|4b7c", TAG+="uaccess", TAG+="udev-acl"

# Blue, NanoS, Aramis, HW.2, Nano X, NanoSP, Stax, Ledger Test,
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2c97", TAG+="uaccess", TAG+="udev-acl"

# Same, but with hidraw-based library (instead of libusb)
KERNEL=="hidraw*", ATTRS{idVendor}=="2c97", MODE="0666"
]]></file_contents>
    </file>
    <file>
      <file_path>/etc/xdg/mimeapps.list</file_path>
      <file_owner>root:root</file_owner>
      <file_permissions>0644</file_permissions>
      <file_contents><![CDATA[[Default Applications]
text/html=firefox.desktop
application/xhtml+xml=firefox.desktop
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
]]></file_contents>
    </file>
  </files>
  <users config:type="list">
    <user>
      <username>root</username>
      <user_password>__ASK__</user_password>
      <encrypted config:type="boolean">false</encrypted>
    </user>
  </users>
</profile>