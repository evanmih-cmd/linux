<?xml version="1.0" encoding="UTF-8"?>
<profile xmlns="http://www.suse.com/1.0/yast2ns"
         xmlns:config="http://www.suse.com/1.0/configns">
  <general>
    <mode>
      <confirm config:type="boolean">false</confirm>
      <final_halt config:type="boolean">true</final_halt>
      <second_stage config:type="boolean">false</second_stage>
    </mode>
    <ask-list config:type="list">
      <ask>
        <title>Portable workstation recovery credential</title>
        <question>Enter the strong LUKS recovery passphrase</question>
        <type>string</type>
        <password config:type="boolean">true</password>
        <path>partitioning,0,partitions,1,crypt_key</path>
        <stage>initial</stage>
        <script>
          <filename>vmbench-tpm-ready</filename>
          <interpreter>shell</interpreter>
          <debug config:type="boolean">false</debug>
          <feedback config:type="boolean">false</feedback>
          <source><![CDATA[
( sleep 2; printf 'VMBENCH_TPM_READY\n' > /dev/ttyS0 ) &
]]></source>
        </script>
      </ask>
      <ask>
        <title>Portable workstation TPM credential</title>
        <question>Enter the short TPM2 boot PIN</question>
        <type>string</type>
        <password config:type="boolean">true</password>
        <stage>initial</stage>
        <script>
          <filename>store-tpm2-pin</filename>
          <interpreter>shell</interpreter>
          <environment config:type="boolean">true</environment>
          <debug config:type="boolean">false</debug>
          <feedback config:type="boolean">false</feedback>
          <rerun_on_error config:type="boolean">true</rerun_on_error>
          <source><![CDATA[
set -eu
if id="$(/usr/bin/keyctl search @u user sdbootutil-tpm2-pin 2>/dev/null)"; then
  printf '%s' "$VAL" | /usr/bin/keyctl pupdate "$id" >/dev/null
else
  printf '%s' "$VAL" | /usr/bin/keyctl padd user sdbootutil-tpm2-pin @u >/dev/null
fi
unset VAL
( sleep 2; printf 'VMBENCH_ROOT_READY\n' > /dev/ttyS0 ) &
]]></source>
        </script>
      </ask>
      <ask>
        <title>Portable workstation administrator</title>
        <question>Enter the root password</question>
        <type>string</type>
        <password config:type="boolean">true</password>
        <path>users,0,user_password</path>
        <stage>initial</stage>
        <script>
          <filename>vmbench-storage-ready</filename>
          <interpreter>shell</interpreter>
          <debug config:type="boolean">false</debug>
          <feedback config:type="boolean">false</feedback>
          <source><![CDATA[
( sleep 2; printf 'VMBENCH_STORAGE_READY\n' > /dev/ttyS0 ) &
]]></source>
        </script>
      </ask>
    </ask-list>
  </general>
  <scripts>
    <pre-scripts config:type="list">
      <script>
        <filename>vmbench-recovery-ready</filename>
        <interpreter>shell</interpreter>
        <debug config:type="boolean">false</debug>
        <feedback config:type="boolean">false</feedback>
        <source><![CDATA[
(
  while [ ! -r /var/log/YaST2/y2log ]; do sleep 1; done
  exec tail -n +1 -F /var/log/YaST2/y2log > /dev/ttyS0 2>&1
) &
( sleep 2; printf 'VMBENCH_RECOVERY_READY\n' > /dev/ttyS0 ) &
]]></source>
      </script>
    </pre-scripts>
  </scripts>
  <language><language>en_US</language></language>
  <keyboard><keymap>english-us</keymap></keyboard>
  <timezone><hwclock>UTC</hwclock><timezone>Europe/Berlin</timezone></timezone>
  <partitioning config:type="list">
    <drive>
      <device>/dev/disk/by-id/ata-PORTABLE_WORKSTATION_SSD_PORTABLETARGET000001</device>
      <initialize config:type="boolean">true</initialize>
      <disklabel>gpt</disklabel>
      <partitions config:type="list">
        <partition>
          <mount>/boot/efi</mount>
          <filesystem config:type="symbol">vfat</filesystem>
          <format config:type="boolean">true</format>
          <size>1GiB</size>
          <partition_id config:type="integer">259</partition_id>
        </partition>
        <partition>
          <size>max</size>
          <lvm_group>system</lvm_group>
          <crypt_method config:type="symbol">systemd_fde</crypt_method>
          <crypt_key>__ASK__</crypt_key>
          <crypt_pbkdf config:type="symbol">argon2id</crypt_pbkdf>
          <crypt_label>portable-system</crypt_label>
        </partition>
      </partitions>
    </drive>
    <drive>
      <device>/dev/system</device>
      <type config:type="symbol">CT_LVM</type>
      <enable_snapshots config:type="boolean">true</enable_snapshots>
      <partitions config:type="list">
        <partition>
          <lv_name>root</lv_name>
          <mount>/</mount>
          <filesystem config:type="symbol">btrfs</filesystem>
          <format config:type="boolean">true</format>
          <size>24GiB</size>
        </partition>
        <partition>
          <lv_name>home</lv_name>
          <mount>/home</mount>
          <filesystem config:type="symbol">xfs</filesystem>
          <format config:type="boolean">true</format>
          <size>max</size>
        </partition>
        <partition>
          <lv_name>swap</lv_name>
          <mount>swap</mount>
          <filesystem config:type="symbol">swap</filesystem>
          <format config:type="boolean">true</format>
          <size>2GiB</size>
        </partition>
      </partitions>
    </drive>
  </partitioning>
  <bootloader>
    <loader_type>systemd-boot</loader_type>
    <global>
      <secure_boot>true</secure_boot>
      <update_nvram>false</update_nvram>
      <timeout config:type="integer">5</timeout>
    </global>
  </bootloader>
  <software>
    <patterns config:type="list"><pattern>base</pattern></patterns>
    <packages config:type="list">
      <package>sdbootutil</package>
      <package>lvm2</package>
    </packages>
    <do_online_update config:type="boolean">false</do_online_update>
    <install_recommended config:type="boolean">true</install_recommended>
  </software>
  <users config:type="list">
    <user>
      <username>root</username>
      <user_password>__ASK__</user_password>
      <encrypted config:type="boolean">false</encrypted>
    </user>
  </users>
</profile>
