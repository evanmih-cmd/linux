<Configuration>
  <!-- Network-enabled disposable desktop. UNRESTRICTED egress:
       use only after accepting LAN/internet exposure. This is not a firewall.
       Host inbox is deliberately read-only; copy a specimen into the guest
       before running anything that needs write access. -->
  <vGPU>Disable</vGPU>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Sandbox-Inbox</HostFolder>
      <SandboxFolder>C:\Incoming</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <!-- Built-in Windows Resource Monitor: visible process/connection activity
       without any third-party download or custom startup script. No approval
       prompts or external egress enforcement. -->
  <LogonCommand>
    <Command>resmon.exe</Command>
  </LogonCommand>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ProtectedClient>Enable</ProtectedClient>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <MemoryInMB>4096</MemoryInMB>
</Configuration>
